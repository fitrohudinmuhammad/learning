<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- xlsx report -->
    <record id="invoice_report_xlsx_wizard_form" model="ir.ui.view">
        <field name="name">invoice.report.xlsx.wizard.form</field>
        <field name="model">invoice.report.xlsx.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_from" required="1"/>
                    <field name="date_to" required="1"/>
                    <field name="salesperson_id"/>
                </group>

                <footer>
                    <button string="Download Xlsx" name="do_action" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="invoice_report_xlsx_wizard_action" model="ir.actions.act_window">
        <field name="name">Invoice Xlsx Report</field>
        <field name="res_model">invoice.report.xlsx.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="invoice_report_xlsx_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
