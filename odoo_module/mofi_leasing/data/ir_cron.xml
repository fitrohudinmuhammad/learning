<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="mofi_leasing_action_generate_loan_info" forcecreate="True" model="ir.cron">
        <field name="name">Action Generate Loan Entries</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="doall" eval="False"/>
        <field name="active" eval="False"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="model_id" ref="mofi_leasing.model_leasing_contract"/>
        <field name="state">code</field>
        <field name="code">model._action_run_generate_loan_entry()</field>
        <field name="priority" eval="5" />
    </record>
