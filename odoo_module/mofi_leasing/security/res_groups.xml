<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_leasing_groups">
        <field name="name">Leasing App</field>
        <field name="description">User access level for leasing</field>
        <field name="sequence">1</field>
    </record>
    <record id="group_leasing_user" model="res.groups">
        <field name="name">Leasing User</field>
        <field name="category_id" ref="module_leasing_groups"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_leasing_manager" model="res.groups">
        <field name="name">Leasing Admin</field>
        <field name="category_id" ref="module_leasing_groups"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')),(4,ref('group_leasing_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
    </record>
    <record id="group_compute_amortization" forcecreate="True" model="res.groups">
        <field name='category_id' ref="base.module_category_usability"/>
        <field name="name">Calculate Amortization</field>
    </record>
</odoo>
