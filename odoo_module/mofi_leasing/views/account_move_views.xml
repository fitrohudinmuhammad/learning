<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- account.move inherit form view -->
    <record id="account_move_inherit_form" model="ir.ui.view">
        <field name="name">account.move.inherit.view.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add your xpath here -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_amortization"
                        type="object" icon="fa-usd"
                        attrs="{'invisible': [('amortization_count','=', 0)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="amortization_count" widget="statinfo" nolabel="1" class="mr4"/>
                        </span>
                        <span class="o_stat_text">Amortization</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='date_maturity']" position="attributes">
                <attribute name="optional"/>
                <attribute name="attrs"/>
                <attribute name="invisible"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_next" model="ir.ui.view">
        <field name="name">account.move.form.inherit.next</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//field[@name='fiscal_position_id']" position="after">
                <field name="contract_ref" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                <field name="amortization_ref" readonly="1"/>
                <!-- <field name="account_bank_no"/> -->
            </xpath>
            <xpath expr="//page[@id='other_tab_entry']//field[@name='fiscal_position_id']" position="after">
                <field name="contract_ref" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                <field name="amortization_ref" readonly="1"/>
                <!-- <field name="account_bank_no"/> -->

            </xpath>
        </field>
    </record>


    <record id="account_move_tree_view_inherit" model="ir.ui.view">
        <field name="name">account.move.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='amount_untaxed_signed']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_state']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_untaxed_signed']" position="before">
                <field name="journal_id"/>
            </xpath>
        </field>
    </record>
    <record id="l10n_inherit_tree" model="ir.ui.view">
        <field name="name">l10n.inherit.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_id_efaktur.account_move_efaktur_tree_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='l10n_id_tax_number']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

        </field>
    </record>
</odoo>
