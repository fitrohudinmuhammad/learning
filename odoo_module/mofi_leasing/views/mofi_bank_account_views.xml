<?xml version='1.0' encoding='utf-8'?>
<odoo>
     <record id="mofi_bank_view_form" model="ir.ui.view">
        <field name="name">mofi.bank.account.view.form</field>
        <field name="model">mofi.bank.account</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="name" invisible="0" required="1"/>
                            <!-- <field name="code" required="1"/> -->
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>


                        <!-- Add your fields here -->

                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- tree view -->

    <record id="mofi_bank_view_tree" model="ir.ui.view">
        <field name="name">mofi.bank.account.view.tree</field>
        <field name="model">mofi.bank.account</field>
        <field name="arch" type="xml">
            <tree>
                <!-- Add your fields here -->
                <field name="name"/>
                <!-- <field name="code"/> -->
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="leasing_bank_action" model="ir.actions.act_window">
        <field name="name">Bank Number</field>
        <field name="res_model">mofi.bank.account</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
