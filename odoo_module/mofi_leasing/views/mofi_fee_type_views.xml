<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- form view -->
    <record id="mofi_fee_type_view_form" model="ir.ui.view">
        <field name="name">mofi.fee.type.view.form</field>
        <field name="model">mofi.fee.type</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="name" invisible="0" required="1"/>
                            <field name="code" required="1"/>
                            <field name="account_journal_id" required="1"/>
                            <field name="is_amortization"/>
                            <field name="amortization_account_journal_id"
                                    attrs="{'required': [('is_amortization', '=', True)]}"/>
                            <field name="is_termination"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- tree view -->

    <record id="mofi_fee_type_view_tree" model="ir.ui.view">
        <field name="name">mofi.fee.type.view.tree</field>
        <field name="model">mofi.fee.type</field>
        <field name="arch" type="xml">
            <tree>
                <!-- Add your fields here -->
                <field name="name"/>
                <field name="code"/>
                <field name="account_journal_id"/>
                <field name="is_amortization"/>
                <field name="amortization_account_journal_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="leasing_fee_type_action" model="ir.actions.act_window">
        <field name="name">Fee Type</field>
        <field name="res_model">mofi.fee.type</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
