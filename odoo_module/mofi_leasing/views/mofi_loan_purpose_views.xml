<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- form view -->
    <record id="mofi_loan_purpose_view_form" model="ir.ui.view">
        <field name="name">mofi.loan.purpose.view.form</field>
        <field name="model">mofi.loan.purpose</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="code" required="1"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- tree view -->

    <record id="mofi_loan_purpose_view_tree" model="ir.ui.view">
        <field name="name">mofi.loan.purpose.tree</field>
        <field name="model">mofi.loan.purpose</field>
        <field name="arch" type="xml">
            <tree>
                <!-- Add your fields here -->
                <field name="name" />
                <field name="code" required="1"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="leasing_loan_purpose_action" model="ir.actions.act_window">
        <field name="name">Loan Purpose</field>
        <field name="res_model">mofi.loan.purpose</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
