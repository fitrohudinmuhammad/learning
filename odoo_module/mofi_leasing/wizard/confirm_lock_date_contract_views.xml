<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_confirm_lock_date_wizard" model="ir.ui.view">
        <field name="name">mofi.confirm.lock.date.wizard.form</field>
        <field name="model">mofi.confirm.lock.date</field>
        <field name="arch" type="xml">
            <form string="Confirm Lock Date Entries">
                <sheet>
                    <strong><b>One or several Order Date is on Lock Period. Please select the date below for Journal Entry</b></strong>
                    <group>
                        <field name="contract_id" invisible="1"/>
                        <field name="journal_date"/>
                    </group>
                    <strong>Please note that this date will be used on the Journal Entry only. The Order Date on the Leasing Contract will remain the same</strong>
                </sheet>
                <footer>
                    <button name="button_proceed" string="Proceed" class="btn-primary" type="object"/>
                    <button name="cancel" special="cancel" data-hotkey="z" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
